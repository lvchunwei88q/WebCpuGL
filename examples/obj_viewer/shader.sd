// obj_viewer/shader.sd  —  ILM threshold toon shading
//
// t0 = albedo (_d)
// t1 = shadow mask (_m), G channel = 1 means this pixel may receive shadow
// t2 = ILM threshold map (_r, grayscale). White (1.0) = no ILM -> fallback
//      to real-time ndotl band. Face uses the baked ILM threshold.

import { transformVec4 } from '/webcpugl/math.js';

export function vs(input, uniforms) {
  const worldPos = transformVec4(uniforms.uModel, [
    input.POSITION[0], input.POSITION[1], input.POSITION[2], 1.0
  ]);
  const pos = transformVec4(uniforms.uViewProj, worldPos);
  return {
    position: pos,
    vNormal:  input.NORMAL,
    vUV:      [input.TEXCOORD[0], 1.0 - input.TEXCOORD[1]],
  };
}

function smoothstep(a, b, x) {
  const t = Math.max(0, Math.min(1, (x - a) / (b - a)));
  return t * t * (3 - 2 * t);
}

export function fs(input, uniforms, samplers) {
  const u = input.vUV[0], v = input.vUV[1];

  const albedo = samplers.t0.sample(u, v);
  const mask   = samplers.t1.sample(u, v);
  const ilm    = samplers.t2.sample(u, v)[0];   // 0..1

  // light direction in world space (normalized, from uniforms)
  const L = uniforms.uLightDir || [0.4, 0.6, 0.6];

  // ---- body / clothes: real-time half-lambert 2 bands ----
  const n = input.vNormal;
  const ndotl = Math.max(0, n[0]*L[0] + n[1]*L[1] + n[2]*L[2]);
  const half = ndotl * 0.5 + 0.5;
  let shadow = half < 0.55 ? 0.5 : 1.0;

  // ---- face: ILM threshold map ----
  // Only when t2 is not the all-white fallback (face parts)
  if (ilm < 0.999) {
    // Front = -Z in model space. ctrl: 0 when light in front, 1 behind.
    const lx = L[0], lz = L[2];
    const len = Math.hypot(lx, lz) || 1;
    const ctrl = 0.5 + 0.5 * (lz / len);
    const diff = ctrl - ilm;
    const isShadow = diff > 0 ? 1 : 0;
    const bias = smoothstep(0, 0.08, Math.abs(diff));
    shadow = 1.0 - (1.0 - 0.55) * isShadow * (0.3 + 0.7 * bias);
  }

  // ---- shadow mask: G channel = 1 means this pixel receives the shadow L ----
  shadow = shadow * mask[1] + (1.0 - mask[1]);

  return [albedo[0]*shadow, albedo[1]*shadow, albedo[2]*shadow, 1.0];
}
