// obj_viewer/shader.sd

import { transformVec4 } from '/webcpugl/math.js';

export function vs(input, uniforms) {
  const worldPos = transformVec4(uniforms.uModel, [
    input.POSITION[0], input.POSITION[1], input.POSITION[2], 1.0
  ]);
  const pos = transformVec4(uniforms.uViewProj, worldPos);
  return {
    position: pos,
    vNormal:  input.NORMAL,
    vUV:      [input.TEXCOORD[0], 1.0 - input.TEXCOORD[1]],  // flip V (OBJ origin bottom-left, image top-left)
  };
}

export function fs(input, uniforms, samplers) {
  const albedo = samplers.t0.sample(input.vUV[0], input.vUV[1]);

  // light direction (normalized)
  const L = [0.4, 0.9, 0.5];
  const inv = 1 / Math.hypot(L[0], L[1], L[2]);
  const ndotl = Math.max(0,
    input.vNormal[0] * L[0] * inv +
    input.vNormal[1] * L[1] * inv +
    input.vNormal[2] * L[2] * inv
  );

  // half-lambert then quantize into 2 toon bands
  const half = ndotl * 0.5 + 0.5;
  const band = half < 0.55 ? 0.45 : 1.0;

  return [
    albedo[0] * band,
    albedo[1] * band,
    albedo[2] * band,
    1.0,
  ];
}
