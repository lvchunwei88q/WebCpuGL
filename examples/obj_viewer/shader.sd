// obj_viewer/shader.sd  —  toon with shadow mask + face SDF ramp

import { transformVec4 } from '/webcpugl/math.js';

export function vs(input, uniforms) {
  const worldPos = transformVec4(uniforms.uModel, [
    input.POSITION[0], input.POSITION[1], input.POSITION[2], 1.0
  ]);
  const pos = transformVec4(uniforms.uViewProj, worldPos);
  return {
    position: pos,
    vNormal:  input.NORMAL,
    vUV:      [input.TEXCOORD[0], 1.0 - input.TEXCOORD[1]],
  };
}

export function fs(input, uniforms, samplers) {
  const u = input.vUV[0], v = input.vUV[1];

  // t0: albedo
  const albedo = samplers.t0.sample(u, v);
  // t1: shadow mask (G channel = 1 means this area may receive real-time shadow)
  const mask = samplers.t1.sample(u, v);
  // t2: baked face SDF ramp (grayscale, 1 = bright, 0 = shadow)
  const ramp = samplers.t2.sample(u, v)[0];

  // real-time directional light (half-lambert, 2 bands)
  const L = [0.4, 0.9, 0.5];
  const inv = 1 / Math.hypot(L[0], L[1], L[2]);
  const ndotl = Math.max(0,
    input.vNormal[0] * L[0] * inv +
    input.vNormal[1] * L[1] * inv +
    input.vNormal[2] * L[2] * inv
  );
  const half = ndotl * 0.5 + 0.5;
  const band = half < 0.55 ? 0.5 : 1.0;

  // shadow mask: only green (G~1) areas receive real-time shadow;
  // black areas (G~0, e.g. eyes, brows, hard trim) stay fully lit.
  const rtShadow = 1.0 - (1.0 - band) * mask[1];

  // face SDF ramp: hard threshold at 0.5, tiny 1/64 smooth band for AA
  const edge = 0.5;
  const sdf = ramp < edge - 0.02 ? 0.55
            : ramp > edge + 0.02 ? 1.0
            : 0.55 + (ramp - (edge - 0.02)) / 0.04 * 0.45;

  const k = rtShadow * sdf;
  return [albedo[0] * k, albedo[1] * k, albedo[2] * k, 1.0];
}
